# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Secrets: the Gemini key must never reach the repo.
# The app keeps it in the browser's localStorage, but a .env here would be
# inlined into the public bundle by Vite, so it stays ignored either way.
.env
.env.*
!.env.example

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Local tooling config (absolute paths, machine specific)
.claude/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log
